{
  "name": "Music Player",
  "short_name": "Music Player",
  "description": "An offline-capable local MP3, WAV and FLAC player with editable metadata and saved playlists.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0c1017",
  "theme_color": "#0c1017",
  "orientation": "any",
  "categories": ["music", "multimedia", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav", ".wave"],
        "audio/flac": [".flac"]
      },
      "icons": [
        {
          "src": "icons/audio-file-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Open Music Player",
      "short_name": "Player",
      "url": "./index.html",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
